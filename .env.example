# Pooled Postgres URL. The running app uses this.
# On Vercel + Neon this is the pooled DATABASE_URL.
# Locally it can be the same URL as DATABASE_URL_UNPOOLED.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Direct (non-pooled) Postgres URL. Prisma Migrate uses this.
# On Vercel + Neon this is DATABASE_URL_UNPOOLED.
# Required for `npm run dev`, `npm run build`, and `npx prisma migrate deploy`.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Used only by `npx prisma db seed`. Not read during deploy.
# At least 8 characters. Do not commit a real password.
# SEED_ADMIN_PASSWORD=
# Optional. Defaults to yu@jstdrmn.com.
# SEED_ADMIN_EMAIL="yu@jstdrmn.com"

# Public origin. On Vercel this is the https URL, with no trailing slash.
APP_URL="http://127.0.0.1:43123"

# CAD cents. Leave HEADLINER blank to display $X/month.
# Other programs store priceCents on the course row.
# HEADLINER_PRICE_CENTS=

# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# HUBSPOT_PRIVATE_APP_TOKEN=
# HUBSPOT_CLIENT_SECRET=
# HUBSPOT_LIVE=false
# HUBSPOT_ACCEPTED_DEAL_STAGES=closedwon,accepted

# Discord. Role sync and Connect Discord no-op until these are set.
# DISCORD_BOT_TOKEN=
# DISCORD_GUILD_ID=
# DISCORD_HEADLINER_ROLE_ID=
# DISCORD_PRODUCER_ROLE_ID=
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# DISCORD_REDIRECT_URI=http://127.0.0.1:43123/api/discord/callback
# DISCORD_HEADLINER_INVITE_URL=

# Optional. Vercel Cron sends this as Authorization: Bearer. Unset locally, the announcement route still runs.
# CRON_SECRET=

# Bunny Stream is the planned video upgrade. The provider stub stays. Unsigned until both are set.
# BUNNY_STREAM_LIBRARY_ID=
# BUNNY_STREAM_TOKEN_KEY=

# Google sign-in. Off until the id, secret, and AUTH_SECRET are all set.
# Password login still works. Do not commit real values.
# Create a free OAuth client in Google Cloud. Redirect:
#   https://jstdrmn-academy.vercel.app/api/auth/google/callback
#   http://127.0.0.1:43123/api/auth/google/callback
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# Also accepted: GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET.
# AUTH_SECRET is at least 16 characters. Generate with: openssl rand -base64 32
# Also accepted: NEXTAUTH_SECRET.
# AUTH_SECRET=
# Public origin, no trailing slash. Falls back to APP_URL. Also accepted: NEXTAUTH_URL.
# AUTH_URL="https://jstdrmn-academy.vercel.app"
# Emails that sign in as Lead. academy@jstdrmn.com is always a Lead, even if this is blank.
# LEAD_EMAILS is the name to use. TEACHER_EMAILS still works and means the same thing.
# A new account, or a student, on this list becomes a Lead on the next Google sign-in.
# Mentor and Instructor are left as they are. A Lead is never removed by the list.
# LEAD_EMAILS="you@gmail.com"
# TEACHER_EMAILS="you@gmail.com,academy@jstdrmn.com"
