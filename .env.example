DATABASE_URL="file:./dev.db"
APP_URL="http://127.0.0.1:43123"

# CAD cents. Leave HEADLINER blank to display $X/month.
# Other programs store priceCents on the course row.
# HEADLINER_PRICE_CENTS=

# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# HUBSPOT_PRIVATE_APP_TOKEN=
# HUBSPOT_CLIENT_SECRET=
# HUBSPOT_LIVE=false
# HUBSPOT_ACCEPTED_DEAL_STAGES=closedwon,accepted

# Discord. Role sync and Connect Discord no-op until these are set.
# DISCORD_BOT_TOKEN=
# DISCORD_GUILD_ID=
# DISCORD_HEADLINER_ROLE_ID=
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# DISCORD_REDIRECT_URI=http://127.0.0.1:43123/api/discord/callback
# DISCORD_HEADLINER_INVITE_URL=

# Bunny Stream. Without both, bunny lessons render an unsigned embed. Not for paid video.
# BUNNY_STREAM_LIBRARY_ID=
# BUNNY_STREAM_TOKEN_KEY=
